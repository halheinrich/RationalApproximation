<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources for this solution. <clear /> drops any inherited sources
    from machine-level NuGet.Config so the build is reproducible from this
    file alone.

    Deliberately no `github` source and no packageSourceCredentials block.
    This project consumes BigRational by ProjectReference, not by package, so
    the GITHUB_PACKAGES_PAT the other members need would be a restore failure
    mode here with nothing behind it. Add the source back only if a
    HalHeinrich.* package is ever referenced from this repo.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping pins every package to a specific feed. With one source that
    is a formality today, but it is the guard that stays correct if a second
    source is ever added: an unmapped source silently becomes a candidate for
    every package, which is the dependency-confusion opening.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
